{
  "openapi": "3.1.0",
  "info": {
    "title": "mydb REST SQL API",
    "version": "1.0.0",
    "description": "SQL and transactional sessions authenticated with database-owned API keys. Keys are administered only through TLS MySQL SQL; 1024 per account, no expiration by default, full credential retrieval supported."
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/v1/sql": {
      "post": {
        "summary": "Execute SQL in a temporary session",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResponse"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                },
                "description": "NDJSON events end with complete or error; EOF alone is not completion."
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,64}$"
            }
          }
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "summary": "Create a persistent SQL session",
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "summary": "Read session state",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "summary": "Close and roll back unfinished work",
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/sessions/{id}/sql": {
      "post": {
        "summary": "Execute SQL in a persistent session",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResponse"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                },
                "description": "NDJSON events end with complete or error; EOF alone is not completion."
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,64}$"
            }
          }
        ]
      }
    },
    "/api/v1/sessions/{id}/touch": {
      "post": {
        "summary": "Refresh session idle lifetime",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/requests/{id}": {
      "get": {
        "summary": "Read request summary; does not retrieve result rows",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/requests/{id}/cancel": {
      "post": {
        "summary": "Request cancellation; does not confirm rollback",
        "responses": {
          "202": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Read capacity and counters; requires API_KEY_ADMIN",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mydb_ak_<id>_<secret>"
      }
    },
    "schemas": {
      "Parameter": {
        "oneOf": [
          {
            "type": [
              "null",
              "boolean",
              "string",
              "number"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "int64",
                  "uint64",
                  "decimal",
                  "string",
                  "binary",
                  "date",
                  "time",
                  "datetime",
                  "timestamp",
                  "year",
                  "json",
                  "geometry"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "float32",
                  "float64"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "bit"
              },
              "value": {
                "type": "string"
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            },
            "required": [
              "type",
              "value",
              "bits"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "vector"
              },
              "value": {
                "type": "string"
              },
              "datatype": {
                "enum": [
                  "FLOAT32",
                  "FLOAT16",
                  "BFLOAT16",
                  "INT8",
                  "BINARY"
                ]
              },
              "dimension": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "value",
              "datatype",
              "dimension"
            ],
            "additionalProperties": false
          }
        ]
      },
      "SqlItem": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "sql"
        ]
      },
      "SqlRequest": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string"
          },
          "sql": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          },
          "statements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/SqlItem"
            }
          },
          "atomic": {
            "type": "boolean",
            "default": false
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "sql"
            ],
            "not": {
              "required": [
                "statements"
              ]
            }
          },
          {
            "required": [
              "statements"
            ],
            "not": {
              "required": [
                "sql"
              ]
            }
          }
        ]
      },
      "CreateSession": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "mysql_errno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sqlstate": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_truncated": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "statement_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "execution_outcome": {
            "enum": [
              "not_started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "transaction_state": {
            "enum": [
              "idle",
              "active",
              "closed",
              "unknown"
            ]
          },
          "rollback_confirmed": {
            "type": "boolean"
          },
          "stage": {
            "enum": [
              "execute",
              "commit"
            ]
          }
        },
        "additionalProperties": false
      },
      "SqlResponse": {
        "type": "object",
        "required": [
          "request_id",
          "results",
          "session",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "session": {
            "type": "object"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution_outcome": {
            "enum": [
              "not_started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "transaction_state": {
            "enum": [
              "idle",
              "active",
              "closed",
              "unknown"
            ]
          },
          "results_omitted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
