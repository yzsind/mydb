{
  "openapi": "3.1.0",
  "info": {
    "title": "mydb REST SQL API",
    "version": "1.0.0",
    "description": "SQL and transactional sessions authenticated with database-owned API keys. Keys are administered only through TLS MySQL SQL; 1024 per account, no expiration by default, full credential retrieval supported. Schema describes canonical JSON numbers; typed decimal preserves values outside safe integer representation. Runtime SQL type constraints remain authoritative."
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/v1/sql": {
      "post": {
        "summary": "Execute SQL in a temporary session",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResponse"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "NDJSON; every line validates against StreamEvent. NDJSON events end with complete or error; EOF alone is not completion."
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,64}$"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "application/json or application/x-ndjson; quality weights supported."
          }
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "summary": "Create a persistent SQL session",
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Path of the created SQL session."
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "summary": "Read session state",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "summary": "Close and roll back unfinished work",
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/sessions/{id}/sql": {
      "post": {
        "summary": "Execute SQL in a persistent session",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResponse"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "NDJSON; every line validates against StreamEvent. NDJSON events end with complete or error; EOF alone is not completion."
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,64}$"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "application/json or application/x-ndjson; quality weights supported."
          }
        ]
      }
    },
    "/api/v1/sessions/{id}/touch": {
      "post": {
        "summary": "Refresh session idle lifetime",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/requests/{id}": {
      "get": {
        "summary": "Read request summary; does not retrieve result rows",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/requests/{id}/cancel": {
      "post": {
        "summary": "Request cancellation; does not confirm rollback",
        "responses": {
          "202": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestStatus"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Read capacity and counters; requires API_KEY_ADMIN",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ready"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; SQL errors can retain completed prefix results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mydb_ak_<id>_<secret>"
      }
    },
    "schemas": {
      "Parameter": {
        "oneOf": [
          {
            "oneOf": [
              {
                "type": [
                  "null",
                  "boolean",
                  "string"
                ]
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "number",
                "not": {
                  "type": "integer"
                }
              }
            ],
            "description": "Use typed decimal/int64/uint64 for integral values outside the safe JSON integer range. SQL type, scale, finite floating range and binary/vector payload constraints are also checked by the server."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "int64",
                  "uint64",
                  "decimal",
                  "string",
                  "binary",
                  "date",
                  "time",
                  "datetime",
                  "timestamp",
                  "year",
                  "json",
                  "geometry"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "float32",
                  "float64"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "bit"
              },
              "value": {
                "type": "string"
              },
              "bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            },
            "required": [
              "type",
              "value",
              "bits"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "vector"
              },
              "value": {
                "type": "string"
              },
              "datatype": {
                "enum": [
                  "FLOAT32",
                  "FLOAT16",
                  "BFLOAT16",
                  "INT8",
                  "BINARY"
                ]
              },
              "dimension": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "value",
              "datatype",
              "dimension"
            ],
            "additionalProperties": false
          }
        ]
      },
      "SqlItem": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "sql"
        ]
      },
      "SqlRequest": {
        "type": "object",
        "properties": {
          "database": {
            "type": [
              "string",
              "null"
            ]
          },
          "sql": {
            "type": [
              "string",
              "null"
            ]
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          },
          "statements": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/SqlItem"
            }
          },
          "atomic": {
            "type": "boolean",
            "default": false
          },
          "timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "sql"
            ],
            "properties": {
              "sql": {
                "type": "string"
              },
              "statements": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "statements"
            ],
            "properties": {
              "statements": {
                "type": "array"
              },
              "sql": {
                "type": "null"
              },
              "params": {
                "maxItems": 0
              }
            }
          }
        ]
      },
      "CreateSession": {
        "type": "object",
        "properties": {
          "database": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "mysql_errno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sqlstate": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_truncated": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "statement_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "execution_outcome": {
            "enum": [
              "not_started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "transaction_state": {
            "enum": [
              "idle",
              "active",
              "closed",
              "unknown"
            ]
          },
          "rollback_confirmed": {
            "type": "boolean"
          },
          "stage": {
            "enum": [
              "execute",
              "commit"
            ]
          }
        },
        "additionalProperties": false
      },
      "SqlResponse": {
        "type": "object",
        "required": [
          "request_id",
          "results",
          "session",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution_outcome": {
            "enum": [
              "not_started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "transaction_state": {
            "enum": [
              "idle",
              "active",
              "closed",
              "unknown"
            ]
          },
          "results_omitted": {
            "type": "boolean"
          }
        }
      },
      "Column": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sql_type": {
            "type": "string"
          },
          "encoding": {
            "enum": [
              "integer_string",
              "decimal_string",
              "float",
              "base64",
              "json_text",
              "vector_text",
              "text"
            ]
          },
          "unsigned": {
            "type": "boolean"
          },
          "length": {
            "type": [
              "integer",
              "null"
            ]
          },
          "precision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "scale": {
            "type": [
              "integer",
              "null"
            ]
          },
          "decimals": {
            "type": [
              "integer",
              "null"
            ]
          },
          "collation_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "org_table": {
            "type": [
              "string",
              "null"
            ]
          },
          "org_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "bits": {
            "type": [
              "integer",
              "null"
            ]
          },
          "vector_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "datatype": {
                    "type": "string"
                  },
                  "dimension": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "datatype",
                  "dimension"
                ]
              }
            ]
          }
        },
        "required": [
          "name",
          "sql_type",
          "encoding",
          "unsigned"
        ]
      },
      "Cell": {
        "oneOf": [
          {
            "type": [
              "null",
              "string",
              "number"
            ]
          },
          {
            "type": "object",
            "properties": {
              "non_finite": {
                "enum": [
                  "nan",
                  "infinity",
                  "-infinity"
                ]
              }
            },
            "required": [
              "non_finite"
            ]
          }
        ]
      },
      "Row": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Cell"
        }
      },
      "Diagnostics": {
        "type": "object",
        "properties": {
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "warnings_truncated": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string"
                },
                "mysql_errno": {
                  "type": "integer",
                  "minimum": 0
                },
                "sqlstate": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "level",
                "mysql_errno",
                "sqlstate",
                "message"
              ]
            }
          },
          "autocommit": {
            "type": "boolean"
          },
          "in_transaction": {
            "type": "boolean"
          },
          "time_zone": {
            "type": "string"
          }
        },
        "required": [
          "warning_count",
          "warnings",
          "warnings_truncated",
          "autocommit",
          "in_transaction",
          "time_zone"
        ]
      },
      "OkResult": {
        "type": "object",
        "properties": {
          "statement_index": {
            "type": "integer",
            "minimum": 0
          },
          "result_index": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostics": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "kind": {
            "const": "ok"
          },
          "affected_rows": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "matched_rows": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_insert_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "info": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "statement_index",
          "result_index",
          "diagnostics",
          "kind",
          "affected_rows",
          "last_insert_id"
        ]
      },
      "ResultSet": {
        "type": "object",
        "properties": {
          "statement_index": {
            "type": "integer",
            "minimum": 0
          },
          "result_index": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostics": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "kind": {
            "const": "result_set"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Column"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Row"
            }
          },
          "row_count": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "statement_index",
          "result_index",
          "diagnostics",
          "kind",
          "columns",
          "rows",
          "row_count"
        ]
      },
      "Result": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OkResult"
          },
          {
            "$ref": "#/components/schemas/ResultSet"
          }
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connection_id": {
            "type": "integer",
            "minimum": 0
          },
          "database": {
            "type": [
              "string",
              "null"
            ]
          },
          "autocommit": {
            "type": "boolean"
          },
          "in_transaction": {
            "type": "boolean"
          },
          "closed": {
            "type": "boolean"
          },
          "time_zone": {
            "type": "string"
          },
          "busy": {
            "type": "boolean"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "closed"
        ],
        "description": "SQL responses and session-control endpoints expose different subsets. Error fallbacks may contain only closed. expires_at_ms is Unix milliseconds on session control responses."
      },
      "ResultSetEnd": {
        "type": "object",
        "properties": {
          "statement_index": {
            "type": "integer",
            "minimum": 0
          },
          "result_index": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostics": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "row_count": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "statement_index",
          "result_index",
          "diagnostics",
          "row_count"
        ]
      },
      "StreamEvent": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "request_start"
              },
              "request_id": {
                "type": "string"
              },
              "session_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "request_id",
              "session_id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "result_start"
              },
              "statement_index": {
                "type": "integer",
                "minimum": 0
              },
              "result_index": {
                "type": "integer",
                "minimum": 0
              },
              "columns": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Column"
                }
              }
            },
            "required": [
              "type",
              "statement_index",
              "result_index",
              "columns"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "rows"
              },
              "statement_index": {
                "type": "integer",
                "minimum": 0
              },
              "result_index": {
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Row"
                }
              }
            },
            "required": [
              "type",
              "statement_index",
              "result_index",
              "rows"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "result_end"
              },
              "result": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/OkResult"
                  },
                  {
                    "$ref": "#/components/schemas/ResultSetEnd"
                  }
                ]
              }
            },
            "required": [
              "type",
              "result"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "complete"
              },
              "request_id": {
                "type": "string"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "type",
              "request_id",
              "session"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "error"
              },
              "error": {
                "$ref": "#/components/schemas/Error"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "type",
              "error",
              "session"
            ]
          }
        ],
        "description": "One JSON object per NDJSON line. Only complete establishes success; error is terminal and EOF alone is inconclusive."
      },
      "RequestStatus": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "accepted",
              "running",
              "cancel_requested",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "execution_outcome": {
            "enum": [
              "not_started",
              "unknown",
              "succeeded",
              "failed"
            ]
          },
          "transaction_state": {
            "enum": [
              "idle",
              "active",
              "closed",
              "unknown"
            ]
          },
          "rollback_confirmed": {
            "type": "boolean"
          },
          "http_status": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "state",
          "execution_outcome"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "connections_limit": {
            "type": "integer",
            "minimum": 0
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          },
          "inflight": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "memory_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "executed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0
          },
          "received_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sent_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "request_elapsed_us": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": []
      },
      "Failure": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "execution_outcome": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
